# Vite HMR for docker-compose.dev.yml
FROM node:20-alpine
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY index.html vite.config.js ./
COPY public/ ./public/
COPY src/ ./src/

ENV NODE_ENV=development
ENV API_PROXY_TARGET=http://api-gateway:3000

EXPOSE 3010
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3010"]
