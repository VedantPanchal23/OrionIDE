# ─────────────────────────────────────────────────────────────────────────────
# Orion IDE — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in all values.
# Each service reads only the variables it needs.
# ─────────────────────────────────────────────────────────────────────────────

# ── SHARED ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Redis password (required for local + prod). URL must include it.
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379

# Postgres (users / billing / usage)
POSTGRES_USER=orion
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=orion
DATABASE_URL=postgres://orion:change-me-postgres-password@postgres:5432/orion

# Stripe (optional — checkout stubs without these)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_TEAM=

# Feature flags — Yjs CRDT collab (set true for live multi-cursor editing)
ENABLE_YJS_COLLAB=true
ENABLE_DEBUGGER_API=true
ENABLE_DEBUGGER_ON_FREE=true
ENABLE_AGENTS=true
# Same-UI OSS: allow agents for free users (also enabled in plans.js free tier)
ENABLE_AGENTS_ON_FREE=true
# Frontend Vite: gate client collab connect (defaults to on in DEV)
# VITE_ENABLE_YJS_COLLAB=true

# Shared secret for gateway → service calls (required)
INTERNAL_SECRET=your-internal-service-secret-min-32-chars

# Entitlements: default fail-closed in production if billing is down.
# Local docker-compose.dev.yml sets ENTITLEMENTS_FAIL_OPEN=true on the gateway.
# ENTITLEMENTS_FAIL_OPEN=false

# ── AUTH SERVICE (Port 3001) ────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
# Dev (compose.dev / Vite :3010 -> gateway :3000):
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Full-stack docker compose (nginx :80) — default for `docker compose up`:
GOOGLE_CALLBACK_URL=http://localhost/api/auth/google/callback
# HTTPS prod:
# GOOGLE_CALLBACK_URL=https://your.domain/api/auth/google/callback

# JWT signing secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your-jwt-secret-here-min-64-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here-min-64-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── DRIVE SERVICE (Port 3002) ──────────────────────────────────────────────
# Must match INTERNAL_SECRET (or set both to the same value)
DRIVE_SERVICE_SECRET=your-internal-service-secret-min-32-chars

# ── EXECUTION SERVICE (Port 3004) ──────────────────────────────────────────
# Self-hosted Piston only — public emkc.org fallback is disabled
PISTON_API_URL=http://piston:2000/api/v2

# ── TERMINAL SERVICE (Port 3007) ───────────────────────────────────────────
TERMINAL_WORKSPACE_ROOT=/workspace
# DRIVE_SERVICE_URL is defined below (used to sync projects into the PTY)
# AUTH_SERVICE_URL is used to refresh Google tokens during long-lived auto-push

# ── LSP SERVICE (Port 3008) ────────────────────────────────────────────────
# Language servers: pyright, typescript-language-server, clangd, yaml, html/css/json
LSP_SERVICE_URL=http://lsp-service:3008
# LSP_DEBUG=1

# ── AGENT SERVICE (Port 3005) ──────────────────────────────────────────────
# Groq API key — free tier at https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# OpenRouter API key — free tier at https://openrouter.ai
OPENROUTER_API_KEY=your-openrouter-api-key

# Internal service URLs (Docker service names resolve within the network)
DRIVE_SERVICE_URL=http://drive-service:3002
EXECUTION_SERVICE_URL=http://execution-service:3004
NOTIFICATION_SERVICE_URL=http://notification-service:3006

# ── API GATEWAY (Port 3000) ────────────────────────────────────────────────
AUTH_SERVICE_URL=http://auth-service:3001
EDITOR_SERVICE_URL=http://editor-service:3003
AGENT_SERVICE_URL=http://agent-service:3005
TERMINAL_SERVICE_URL=http://terminal-service:3007
# LSP_SERVICE_URL defined above (port 3008)

# ── FRONTEND ───────────────────────────────────────────────────────────────
# All-in-one `docker compose up` (nginx :80):  http://localhost
# Hot-reload `docker-compose.dev.yml` / Vite:  http://localhost:3010
# HTTPS prod:                                  https://your.domain
FRONTEND_URL=http://localhost

# ── LIVE QA (optional) ─────────────────────────────────────────────────────
# After Google login, set this to run real Drive E2E:
# ORION_ACCESS_TOKEN=
